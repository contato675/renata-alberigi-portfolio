{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Obra do portfólio de Renata Alberigi",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "year",
    "technique",
    "dimensions",
    "status",
    "cover",
    "images"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "$ref": "#/$defs/localized"
    },
    "year": {
      "type": "string",
      "minLength": 1
    },
    "technique": {
      "$ref": "#/$defs/localized"
    },
    "dimensions": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "description": {
      "$ref": "#/$defs/localized"
    },
    "category": {
      "$ref": "#/$defs/localized"
    },
    "cover": {
      "type": "integer",
      "minimum": 0
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "alt",
          "width",
          "height"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^assets/images/[a-z0-9][a-z0-9/_.-]*\\.(webp|jpg|jpeg|png|avif)$"
          },
          "alt": {
            "$ref": "#/$defs/localized"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "caption": {
            "$ref": "#/$defs/localized"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "width",
                "height"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^assets/images/[a-z0-9][a-z0-9/_.-]*\\.(webp|jpg|jpeg|png|avif)$"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    },
    "originalTitle": {
      "type": "string",
      "minLength": 1
    },
    "collection": {
      "enum": [
        "paintings",
        "digital",
        "brand-design"
      ]
    },
    "titleStatus": {
      "const": "catalogue-label"
    },
    "yearIsCollectionPeriod": {
      "type": "boolean"
    }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "pt-BR",
        "fr"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "pt-BR": {
          "type": "string",
          "minLength": 1
        },
        "fr": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
