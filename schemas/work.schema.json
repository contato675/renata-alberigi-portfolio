{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Obra do portfólio de Renata Alberigi",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "year",
    "technique",
    "dimensions",
    "status",
    "cover",
    "images"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "string",
      "minLength": 1
    },
    "technique": {
      "type": "string",
      "minLength": 1
    },
    "dimensions": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "cover": {
      "type": "integer",
      "minimum": 0
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "alt",
          "width",
          "height"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^assets/images/[a-z0-9][a-z0-9/_.-]*\\.(webp|jpg|jpeg|png|avif)$"
          },
          "alt": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "caption": {
            "type": "string"
          }
        }
      }
    }
  }
}
